   "source": [
    "# ── Cell 6: Real-time inference from browser camera ───────────────────────────\n",
    "import tensorflow as tf\n",
    "from collections import deque\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import clear_output\n",
    "\n",
    "WINDOW_SIZE = 15\n",
    "MIN_CONF    = 0.70\n",
    "HOLD_FRAMES = 8\n",
    "\n",
    "sign_model = tf.keras.models.load_model('data/sign_model.keras')\n",
    "classes    = np.load('data/label_classes.npy', allow_pickle=True)\n",
    "print(f'✅ Model loaded. Classes: {classes}')\n",
    "\n",
    "frame_buffer  = deque(maxlen=WINDOW_SIZE)\n",
    "candidate     = None\n",
    "candidate_cnt = 0\n",
    "displayed     = None\n",
    "displayed_conf= 0.0\n",
    "\n",
    "CLASS_COLORS = {\n",
    "    'Hello':    '#00C832',\n",
    "    'ILoveYou': '#C800C8',\n",
    "    'No':       '#DC0032',\n",
    "    'Please':   '#C88C00',\n",
    "    'Thanks':   '#00B4B4',\n",
    "    'Yes':      '#008CFF',\n",
    "}\n",
    "\n",
    "print('\\n🎥 Starting live inference — allow camera access when prompted')\n",
    "print('Run this cell and show your hand signs!')\n",
    "print('Interrupt kernel (■) to stop.\\n')\n",
    "\n",
    "RUN_FRAMES = 200   # number of frames to process before stopping\n",
    "\n",
    "for frame_num in range(RUN_FRAMES):\n",
    "    frame = capture_frame_from_browser()\n",
    "    feat, side = get_landmarks_from_frame(frame)\n",
    "\n",
    "    if feat is not None:\n",
    "        frame_buffer.append(feat)\n",
    "\n",
    "        if len(frame_buffer) == WINDOW_SIZE:\n",
    "            seq   = np.array(frame_buffer, dtype=np.float32)[np.newaxis]\n",
    "            probs = sign_model.predict(seq, verbose=0)[0]\n",
    "            top_i = int(np.argmax(probs))\n",
    "            top_p = float(probs[top_i])\n",
    "            pred  = classes[top_i]\n",
    "\n",
    "            if top_p >= MIN_CONF:\n",
    "                if pred == candidate:\n",
    "                    candidate_cnt += 1\n",
    "                else:\n",
    "                    candidate     = pred\n",
    "                    candidate_cnt = 1\n",
    "                if candidate_cnt >= HOLD_FRAMES:\n",
    "                    displayed      = candidate\n",
    "                    displayed_conf = top_p\n",
    "\n",
    "            # ── Display frame + prediction ─────────────────────────────────\n",
    "            clear_output(wait=True)\n",
    "            fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "            # Camera frame\n",
    "            ax1.imshow(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))\n",
    "            ax1.axis('off')\n",
    "            label_text = f'{displayed}  {displayed_conf:.0%}' if displayed else 'Detecting...'\n",
    "            color      = CLASS_COLORS.get(displayed, '#FFFFFF') if displayed else '#FF0000'\n",
    "            ax1.set_title(label_text, fontsize=22, fontweight='bold', color=color)\n",
    "\n",
    "            # Confidence bar chart\n",
    "            bar_colors = [CLASS_COLORS.get(c, '#888888') for c in classes]\n",
    "            bars = ax2.barh(classes, probs, color=bar_colors)\n",
    "            ax2.set_xlim(0, 1)\n",
    "            ax2.set_xlabel('Confidence')\n",
    "            ax2.set_title('Class Probabilities')\n",
    "            for bar, p in zip(bars, probs):\n",
    "                ax2.text(min(p+0.02, 0.95), bar.get_y()+bar.get_height()/2,\n",
    "                         f'{p:.0%}', va='center', fontsize=10)\n",
    "\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "    else:\n",
    "        frame_buffer.clear()\n",
    "        candidate     = None\n",
    "        candidate_cnt = 0\n",
    "        displayed     = None\n",
    "        clear_output(wait=True)\n",
    "        print(f'Frame {frame_num}: ✋ No hand detected — show your hand')\n",
    "\n",
    "print('\\n✅ Inference session complete.')"
   ]
  }
 ]
}"
